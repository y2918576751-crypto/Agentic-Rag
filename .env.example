# Use the course-approved DeepSeek-V4-Flash endpoint and its actual model ID.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=
LLM_TIMEOUT=120
# DeepSeek defaults to thinking mode; disable it for bounded JSON actions.
# Leave empty for providers that do not support this parameter.
LLM_THINKING=disabled
